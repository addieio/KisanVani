# ==========================================
# KisanVaani (किसानवाणी) Environment Variables
# Copy this file to .env.local and populate with your own credentials.
# ==========================================

# Supabase Database & Auth (PostgreSQL 16)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Google Gemini 3.8 Flash (AI Agronomist Doctor & Voice NLU)
GEMINI_API_KEY=your-gemini-api-key

# Twilio Telephony (Voice IVR & Automated Hindi Calls/SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Sarvam AI (Indic Text-to-Speech Bulbul v4-flash)
SARVAM_API_KEY=your-sarvam-api-key

# Application Base URL (for Twilio webhook callbacks)
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
